+pub(super) fn registry_error(error: anyhow::Error) -> SupervisorError {
+    if error.is::<worker_registry::RegistryBusy>() {
+        SupervisorError::RegistryBusy
+    } else {
+        SupervisorError::Acp(AcpError::Spawn(error.to_string()))
+    }
