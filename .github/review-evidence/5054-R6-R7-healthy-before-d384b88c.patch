+                            if !state.acp_supervisor.is_owned(id).await {
+                                break;
+                            }
+                            tokio::time::sleep(Duration::from_millis(20)).await;
+                        }
+                    })
+                    .await
+                    .is_ok(),
+                )
+            } else {
+                None
+            };
